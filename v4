class BaseTerminal(ABC):
    """Interface abstraite pour terminaux."""
    
    def __init__(self, config: TerminalConfig, logger: NexusLogger):
        self.config = config
        self.logger = logger
        self.security = SecurityValidator(config)
    
    @abstractmethod
    def execute(self, command: str, **kwargs) -> CommandResult:
        """Exécute une commande."""
        pass
    
    @abstractmethod
    def get_capabilities(self) -> Dict[str, Any]:
        """Retourne les capacités."""
        pass

