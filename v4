class DockerTerminal(BaseTerminal):
    """Terminal Docker container."""
    
    def __init__(self, config: TerminalConfig, logger: NexusLogger):
        super().__init__(config, logger)
        self.client = None
        self._init_docker_client()
    
    def _init_docker_client(self):
        """Initialise client Docker."""
        if not DOCKER_AVAILABLE:
            self.logger.warning("Docker SDK non installé")
            return
        
        try:
            self.client = docker.from_env()
            self.logger.info("Client Docker initialisé")
        except Exception as e:
            self.logger.error(f"Docker unavailable: {e}")
    
    def execute(self, command: str, 
                container: str = None,
                timeout: Optional[int] = None) -> CommandResult:
        """Exécute dans container Docker."""
        container = container or self.config.DEFAULT_CONTAINER
        timeout = timeout or self.config.DEFAULT_TIMEOUT
        result = CommandResult(
            command=command, 
            shell_type=ShellType.DOCKER,
            exit_code=1
        )
        
        if not self.client:
            result.stderr = "Docker client non initialisé"
            return result
        
        try:
            # Pull image
            pull_result = self._pull_image(container)
            if not pull_result:
                result.stderr = f"Impossible de pull {container}"
                return result
            
            start = time.time()
            
            # Exécution
            exec_result = self.client.containers.run(
                container,
                command,
                remove=True,
                detach=False,
                network_disabled=False,
                mem_limit=f"{self.config.CONTAINER_MEMORY_MB}m"
            )
            
            result.stdout = exec_result.decode('utf-8', errors='replace')
            result.exit_code = 0
            
        except docker.errors.NotFound:
            result.stderr = f"Image {container} non trouvée"
        except docker.errors.APIError as e:
            result.stderr = f"Erreur Docker API: {e}"
        except subprocess.TimeoutExpired:
            result.timeout = True
            result.stderr = f"Timeout Docker après {timeout}s"
        except Exception as e:
            result.stderr = f"Erreur Docker: {str(e)}"
        
        result.duration_ms = (time.time() - start) * 1000
        return result
    
    def _pull_image(self, image: str) -> bool:
        """Pull image Docker."""
        try:
            self.logger.info(f"Pulling {image}...")
            self.client.images.pull(image)
            self.logger.info(f"✓ {image} prêt")
            return True
        except Exception as e:
            self.logger.error(f"Pull failed: {e}")
            return False
    
    def get_capabilities(self) -> Dict[str, Any]:
        return {
            "engine": "docker",
            "sandbox": True,
            "isolated": True,
            "network": True,
            "persistence": False
        }

