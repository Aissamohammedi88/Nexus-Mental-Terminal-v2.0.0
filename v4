@dataclass
class CommandResult:
    """Résultat d'exécution de commande."""
    
    command: str
    shell_type: ShellType = ShellType.BASH
    exit_code: int = 0
    stdout: str = ""
    stderr: str = ""
    duration_ms: float = 0.0
    timestamp: datetime = field(default_factory=datetime.now)
    security_level: SecurityLevel = SecurityLevel.MEDIUM
    blocked: bool = False
    timeout: bool = False
    pid: Optional[int] = None
    memory_usage_mb: float = 0.0
    cpu_percent: float = 0.0
    
    def to_dict(self) -> Dict[str, Any]:
        """Conversion dict JSON."""
        return {
            "command": self.command,
            "shell_type": self.shell_type.name,
            "exit_code": self.exit_code,
            "stdout": self.stdout,
            "stderr": self.stderr,
            "duration_ms": self.duration_ms,
            "timestamp": self.timestamp.isoformat(),
            "blocked": self.blocked,
            "timeout": self.timeout,
            "memory_mb": self.memory_usage_mb,
            "cpu_percent": self.cpu_percent
        }
    
    @property
    def success(self) -> bool:
        """Statut succès."""
        return self.exit_code == 0 and not self.blocked
    
    @property
    def output_summary(self) -> str:
        """Résumé concis."""
        if self.blocked:
            return f"⛔ COMMANDE BLOQUÉE"
        if self.timeout:
            return f"⏱️ TIMEOUT ({self.duration_ms:.0f}ms)"
        if self.exit_code != 0:
            return f"❌ ERREUR (code {self.exit_code})"
        return f"✅ SUCCÈS ({len(self.stdout)} octets)"

