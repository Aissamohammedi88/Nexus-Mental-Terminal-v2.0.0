class HybridTerminal:
    """Terminal hybride multi-environnements."""
    
    def __init__(self, config: TerminalConfig = None):
        self.config = config or TerminalConfig()
        self.logger = NexusLogger(self.config)
        self.session = SessionData()
        
        # Initialisation terminaux
        self.terminales: Dict[ShellType, BaseTerminal] = {}
        self._init_terminals()
        
        # Historique
        self.history: List[CommandResult] = []
        
        self.logger.info("🚀 Terminal hybride initialisé")
    
    def _init_terminals(self):
        """Initialise tous les terminaux."""
        self.terminales[ShellType.BASH] = BashTerminal(self.config, self.logger)
        self.terminales[ShellType.POWERSHELL] = PowerShellTerminal(self.config, self.logger)
        self.terminales[ShellType.DOCKER] = DockerTerminal(self.config, self.logger)
        self.terminales[ShellType.PYTHON] = PythonSandboxTerminal(self.config, self.logger)
        self.terminales[ShellType.SSH] = SSHTerminal(self.config, self.logger)
        self.terminales[ShellType.GIT] = GitTerminal(self.config, self.logger)
        
        self.logger.info(f"{len(self.terminales)} terminaux initialisés")
    
    def execute(self, command: str, shell_type: ShellType = ShellType.BASH,
                **kwargs) -> CommandResult:
        """Exécute commande sur terminal spécifié."""
        self.session.commands_executed += 1
        
        terminal = self.terminales.get(shell_type)
        if not terminal:
            return CommandResult(
                command=command,
                stderr=f"Terminal {shell_type.name} non disponible",
                exit_code=1
            )
        
        # Exécution
        result = terminal.execute(command, **kwargs)
        
        # Enregistrement historique
        self.history.append(result)
        if len(self.history) > self.config.COMMAND_HISTORY_SIZE:
            self.history.pop(0)
        
        # Statistiques
        if not result.success:
            self.session.failed_commands += 1
        
        self.session.total_duration_ms += result.duration_ms
        
        return result
    
    def execute_bash(self, command: str, **kwargs) -> CommandResult:
        """Raccourci Bash."""
        return self.execute(command, ShellType.BASH, **kwargs)
    
    def execute_powershell(self, command: str, **kwargs) -> CommandResult:
        """Raccourci PowerShell."""
        return self.execute(command, ShellType.POWERSHELL, **kwargs)
    
    def execute_docker(self, command: str, **kwargs) -> CommandResult:
        """Raccourci Docker."""
        return self.execute(command, ShellType.DOCKER, **kwargs)
    
    def execute_python(self, code: str, **kwargs) -> CommandResult:
        """Raccourci Python."""
        return self.execute(code, ShellType.PYTHON, **kwargs)
    
    def execute_ssh(self, host: str, user: str, command: str, **kwargs) -> CommandResult:
        """Raccourci SSH."""
        return self.terminales[ShellType.SSH].execute(host, user, command, **kwargs)
    
    def get_session_stats(self) -> Dict[str, Any]:
        """Statistiques session."""
        return {
            "session_id": self.session.session_id,
            "duration_seconds": (datetime.now() - self.session.start_time).total_seconds(),
            "commands_executed": self.session.commands_executed,
            "failed_commands": self.session.failed_commands,
            "avg_duration_ms": self.session.total_duration_ms / max(1, self.session.commands_executed),
            "success_rate": (1 - self.session.failed_commands / max(1, self.session.commands_executed)) * 100
        }
    
    def export_history(self, format: str = "json") -> str:
        """Export historique."""
        if format == "json":
            return json.dumps([h.to_dict() for h in self.history], indent=2)
        elif format == "text":
            lines = []
            for h in self.history:
                lines.append(f"[{h.timestamp}] {h.shell_type.name}: {h.command}")
                if h.stderr:
                    lines.append(f"  STDERR: {h.stderr[:100]}")
            return "\n".join(lines)
        return ""
    
    def cleanup(self):
        """Nettoyage ressources."""
        self.logger.info("Nettoyage terminal...")
        # Fermeture éventuelle clients

