class ExecutionStatus(Enum):
    STATUT EXÉCUTION
    SUCCESS = auto()
    FAILED = auto()
    TIMEOUT = auto()
    BLOCKED = auto()
    ERROR = auto()

class SecurityLevel(Enum):
    NIVEAUX SÉCURITÉ
