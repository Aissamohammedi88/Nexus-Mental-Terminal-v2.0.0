class PythonSandboxTerminal(BaseTerminal):
    """Sandbox Python sécurisée."""
    
    RESTRICTED_BUILTINS = ['eval', 'exec', 'compile', '__import__', 
                          'open', 'input', 'raw_input']
    
    def execute(self, code: str, timeout: Optional[int] = None) -> CommandResult:
        """Exécute code Python."""
        timeout = timeout or 30
        result = CommandResult(
            command=code[:100] + "..." if len(code) > 100 else code,
            shell_type=ShellType.PYTHON
        )
        
        start = time.time()
        
        # Création environnement sécurisé
        safe_globals = {
            '__builtins__': self._get_safe_builtins(),
            '__name__': '__main__',
            '__doc__': None,
            '__package__': None
        }
        
        safe_locals = {}
        
        try:
            # Compilation
            compiled = compile(code, '<sandbox>', 'exec')
            
            # Exécution avec timeout thread
            output_queue = Queue()
            
            def run_code():
                old_stdout = sys.stdout
                sys.stdout = output_capture = StringIO()
                
                try:
                    exec(compiled, safe_globals, safe_locals)
                    output_queue.put(('success', output_capture.getvalue()))
                except Exception as e:
                    output_queue.put(('error', str(e)))
                finally:
                    sys.stdout = old_stdout
            
            thread = threading.Thread(target=run_code)
            thread.daemon = True
            thread.start()
            thread.join(timeout=timeout)
            
            if thread.is_alive():
                result.timeout = True
                result.stderr = f"Python timeout après {timeout}s"
                result.exit_code = 124
            else:
                try:
                    status, output = output_queue.get_nowait()
                    if status == 'success':
                        result.stdout = output
                        result.exit_code = 0
                    else:
                        result.stderr = output
                        result.exit_code = 1
                except Empty:
                    result.stderr = "Exécution bloquée"
                    result.exit_code = 1
        
        except SyntaxError as e:
            result.stderr = f"SyntaxError: {e}"
            result.exit_code = 1
        except Exception as e:
            result.stderr = f"Erreur Python: {str(e)}"
            result.exit_code = 1
        
        result.duration_ms = (time.time() - start) * 1000
        return result
    
    def _get_safe_builtins(self) -> Dict[str, Any]:
        """Builtins sécurisés."""
        import builtins
        
        safe = {}
        for name in dir(builtins):
            if name not in self.RESTRICTED_BUILTINS:
                obj = getattr(builtins, name)
                if callable(obj) or isinstance(obj, (int, str, list, dict)):
                    safe[name] = obj
        return safe
    
    def get_capabilities(self) -> Dict[str, Any]:
        return {
            "language": "python",
            "sandbox": True,
            "restricted_builtins": self.RESTRICTED_BUILTINS,
            "timeout": 30
        }

