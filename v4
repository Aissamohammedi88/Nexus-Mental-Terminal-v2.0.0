class GitTerminal(BaseTerminal):
    """Terminal Git opérations."""
    
    def execute(self, command: str, repo_path: Optional[str] = None,
                timeout: Optional[int] = None) -> CommandResult:
        """Exécute commande Git."""
        full_cmd = f"git {command}"
        return self._execute_git(full_cmd, repo_path, timeout)
    
    def clone(self, url: str, destination: Optional[str] = None) -> CommandResult:
        """Clone repository."""
        cmd = f"clone {url}"
        if destination:
            cmd += f" {destination}"
        return self.execute(cmd)
    
    def commit(self, message: str, repo_path: Optional[str] = None) -> CommandResult:
        """Commit."""
        return self.execute(f'commit -m "{message}"', repo_path)
    
    def push(self, remote: str = "origin", branch: str = "main",
             repo_path: Optional[str] = None) -> CommandResult:
        """Push."""
        return self.execute(f"push {remote} {branch}", repo_path)
    
    def pull(self, remote: str = "origin", branch: str = "main",
             repo_path: Optional[str] = None) -> CommandResult:
        """Pull."""
        return self.execute(f"pull {remote} {branch}", repo_path)
    
    def _execute_git(self, command: str, repo_path: Optional[str] = None,
                     timeout: Optional[int] = None) -> CommandResult:
        """Exécution Git interne."""
        timeout = timeout or self.config.DEFAULT_TIMEOUT
        result = CommandResult(
            command=command,
            shell_type=ShellType.GIT
        )
        
        cwd = repo_path or "."
        
        try:
            proc = subprocess.Popen(
                command.split(),
                cwd=cwd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )
            
            stdout, stderr = proc.communicate(timeout=timeout)
            result.stdout = stdout
            result.stderr = stderr
            result.exit_code = proc.returncode
            
        except subprocess.TimeoutExpired:
            result.timeout = True
            result.stderr = f"Git timeout après {timeout}s"
            result.exit_code = 124
        except Exception as e:
            result.stderr = f"Erreur Git: {str(e)}"
            result.exit_code = 1
        
        return result
    
    def get_capabilities(self) -> Dict[str, Any]:
        return {
            "vcs": "git",
            "operations": ["clone", "commit", "push", "pull", "branch", "merge"]
        }

