class SSHTerminal(BaseTerminal):
    """Terminal SSH distant."""
    
    def execute(self, host: str, user: str, command: str,
                key_path: Optional[str] = None,
                password: Optional[str] = None,
                timeout: Optional[int] = None) -> CommandResult:
        """Exécute commande sur serveur distant."""
        if not PARAMIKO_AVAILABLE:
            return CommandResult(
                command=command,
                stderr="paramiko non installé: pip install paramiko",
                exit_code=127,
                shell_type=ShellType.SSH
            )
        
        timeout = timeout or self.config.SSH_TIMEOUT
        result = CommandResult(
            command=f"ssh {user}@{host}",
            shell_type=ShellType.SSH
        )
        
        client = paramiko.SSHClient()
        client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
        
        try:
            connect_kwargs = {
                "hostname": host,
                "username": user,
                "timeout": timeout
            }
            
            if key_path:
                connect_kwargs["key_filename"] = key_path
            elif password:
                connect_kwargs["password"] = password
            else:
                result.stderr = "Clé ou mot de passe requis"
                result.exit_code = 1
                return result
            
            start = time.time()
            client.connect(**connect_kwargs)
            
            stdin, stdout, stderr = client.exec_command(command, timeout=timeout)
            
            result.stdout = stdout.read().decode('utf-8', errors='replace')
            result.stderr = stderr.read().decode('utf-8', errors='replace')
            result.exit_code = stdout.channel.recv_exit_status()
            
            client.close()
            
        except paramiko.AuthenticationException:
            result.stderr = "Authentification échouée"
            result.exit_code = 1
        except paramiko.SSHException as e:
            result.stderr = f"Erreur SSH: {e}"
            result.exit_code = 1
        except socket.timeout:
            result.timeout = True
            result.stderr = f"SSH timeout après {timeout}s"
            result.exit_code = 124
        except Exception as e:
            result.stderr = f"Erreur SSH: {str(e)}"
            result.exit_code = 1
        
        result.duration_ms = (time.time() - start) * 1000
        return result
    
    def get_capabilities(self) -> Dict[str, Any]:
        return {
            "protocol": "ssh",
            "remote": True,
            "auth_methods": ["key", "password"],
            "encrypted": True
        }

