class PowerShellTerminal(BaseTerminal):
    """Terminal PowerShell Windows."""
    
    def execute(self, command: str, timeout: Optional[int] = None) -> CommandResult:
        """Exécute commande PowerShell."""
        timeout = timeout or self.config.DEFAULT_TIMEOUT
        result = CommandResult(command=command, shell_type=ShellType.POWERSHELL)
        
        if not self._is_windows():
            result.stderr = "PowerShell disponible uniquement sur Windows"
            result.exit_code = 127
            return result
        
        start = time.time()
        
        try:
            proc = subprocess.Popen(
                ["powershell", "-Command", command],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )
            
            try:
                stdout, stderr = proc.communicate(timeout=timeout)
                result.stdout = stdout[:self.config.MAX_OUTPUT_SIZE]
                result.stderr = stderr[:self.config.MAX_OUTPUT_SIZE]
                result.exit_code = proc.returncode
            except subprocess.TimeoutExpired:
                proc.kill()
                result.timeout = True
                result.stderr = f"Timeout PowerShell après {timeout}s"
                result.exit_code = 124
                
        except FileNotFoundError:
            result.stderr = "PowerShell non trouvé"
            result.exit_code = 127
        except Exception as e:
            result.stderr = f"Erreur PowerShell: {str(e)}"
            result.exit_code = 1
        
        result.duration_ms = (time.time() - start) * 1000
        return result
    
    def _is_windows(self) -> bool:
        return platform.system() == "Windows"
    
    def get_capabilities(self) -> Dict[str, Any]:
        return {
            "shell": "powershell",
            "platform": "windows",
            "version": self._get_ps_version()
        }
    
    def _get_ps_version(self) -> str:
        try:
            result = self.execute("$PSVersionTable.PSVersion.ToString()", timeout=5)
            return result.stdout.strip() if result.success else "unknown"
        except:
            return "unknown"

