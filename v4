@dataclass
class TerminalConfig:
    """Configuration centrale du terminal."""
    
    # Timeout par défaut (secondes)
    DEFAULT_TIMEOUT: int = 30
    
    # Taille max sortie (octets)
    MAX_OUTPUT_SIZE: int = 10 * 1024 * 1024  # 10MB
    
    # Sandbox par défaut
    SANDBOX_ENABLED: bool = True
    
    # Journaux
    LOG_LEVEL: str = "INFO"
    LOG_FILE: str = "nexus_terminal.log"
    
    # Sécurité
    BLOCKED_COMMANDS: List[str] = field(default_factory=lambda: [
        "rm -rf /", "mkfs", "dd if=/dev/zero", ":(){:|:&};:",
        "chmod -R 777 /", "passwd root", "shutdown", "reboot"
    ])
    
    # Containers Docker
    DEFAULT_CONTAINER: str = "alpine:latest"
    CONTAINER_MEMORY_MB: int = 512
    
    # SSH
    SSH_TIMEOUT: int = 10
    SSH_KEEP_ALIVE: int = 30
    
    # Performance
    MAX_CONCURRENT_COMMANDS: int = 10
    COMMAND_HISTORY_SIZE: int = 1000
    
    # Couleurs
    USE_COLORS: bool = True
    
    # Audit
    AUDIT_LOG: bool = True

