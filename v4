class InteractiveCLI:
    """Interface CLI interactive."""
    
    PROMPT = f"{Fore.CYAN}nexus{Style.RESET_ALL}@terminal{Style.RESET_ALL}$ "
    
    def __init__(self, terminal: HybridTerminal):
        self.terminal = terminal
        self.running = True
        
        self.banner()
    
    def banner(self):
        """Affiche bannière."""
        banner = f"""
{Fore.MAGENTA}╔══════════════════════════════════════════════════════════════╗
║  NEXUS INTELLIGENT TERMINAL v2.0                           ║
║  AI-Powered Multi-Environment Shell                       ║
╚══════════════════════════════════════════════════════════════╝{Style.RESET_ALL}

{Fore.YELLOW}Terminaux disponibles:{Style.RESET_ALL}
  • bash      - Linux/Mac native
  • powershell- Windows PowerShell  
  • docker    - Isolated containers
  • ssh       - Remote servers
  • python    - Sandboxed execution
  • git       - Version control

{Fore.GREEN}Tapez 'help' pour la liste des commandes{Style.RESET_ALL}
{'='*60}
"""
        print(banner)
    
    def run(self):
        """Boucle principale."""
        while self.running:
            try:
                if COLORAMA_AVAILABLE:
                    user_input = input(self.PROMPT)
                else:
                    user_input = input(self.PROMPT.replace(Fore.CYAN, "").replace(Style.RESET_ALL, ""))
                
                user_input = user_input.strip()
                
                if not user_input:
                    continue
                
                self.process_command(user_input)
                
            except KeyboardInterrupt:
                print(f"\n{Fore.YELLOW}Arrêt... Appuyez à nouveau pour quitter{Style.RESET_ALL}")
            except EOFError:
                self.running = False
            except Exception as e:
                print(f"{Fore.RED}Erreur: {e}{Style.RESET_ALL}")
        
        self.cleanup()
    
    def process_command(self, cmd: str):
        """Traite commande utilisateur."""
        parts = cmd.split(maxsplit=1)
        command = parts[0].lower()
        args = parts[1] if len(parts) > 1 else ""
        
        handlers = {
            'bash': lambda: self.terminal.execute_bash(args),
            'ps': lambda: self.terminal.execute_powershell(args),
            'powershell': lambda: self.terminal.execute_powershell(args),
            'docker': lambda: self.terminal.execute_docker(args),
            'python': lambda: self.terminal.execute_python(args),
            'py': lambda: self.terminal.execute_python(args),
            'git': lambda: self.terminal.execute(args, ShellType.GIT),
            'stats': self.show_stats,
            'history': self.show_history,
            'help': self.show_help,
            'clear': self.clear_screen,
            'exit': self.quit,
            'quit': self.quit,
            '?': self.show_help,
            'h': self.show_help
        }
        
        handler = handlers.get(command)
        if handler:
            result = handler()
            if result and isinstance(result, CommandResult):
                self.display_result(result)
        else:
            # Essai direct bash
            print(f"{Fore.YELLOW}Commande inconnue. Tentative bash...{Style.RESET_ALL}")
            result = self.terminal.execute_bash(cmd)
            self.display_result(result)
    
    def display_result(self, result: CommandResult):
        """Affiche résultat."""
        print()
        
        if result.blocked:
            print(f"{Fore.RED}⛔ {result.stderr}{Style.RESET_ALL}")
        elif result.timeout:
            print(f"{Fore.YELLOW}⏱️ {result.stderr}{Style.RESET_ALL}")
        elif result.exit_code != 0:
            print(f"{Fore.RED}❌ Exit {result.exit_code}{Style.RESET_ALL}")
        else:
            print(f"{Fore.GREEN}✅ {Style.RESET_ALL}", end="")
        
        if result.stdout:
            print(result.stdout)
        
        if result.stderr and not result.blocked:
            print(f"{Fore.RED}STDERR: {result.stderr}{Style.RESET_ALL}")
        
        print(f"{Fore.DIM}[{result.duration_ms:.0f}ms] exit={result.exit_code}{Style.RESET_ALL}")
        print()
    
    def show_stats(self):
        """Affiche statistiques."""
        stats = self.terminal.get_session_stats()
        print(f"""
{Fore.CYAN}=== STATISTIQUES SESSION ==={Style.RESET_ALL}
Session ID: {stats['session_id']}
Durée: {stats['duration_seconds']:.1f}s
Commandes: {stats['commands_executed']}
Échecs: {stats['failed_commands']}
Succès: {stats['success_rate']:.1f}%
Temps moyen: {stats['avg_duration_ms']:.1f}ms
""")
    
    def show_history(self, limit: int = 10):
        """Affiche historique."""
        history = self.terminal.history[-limit:]
        print(f"\n{Fore.CYAN}=== HISTORIQUE (dernières {len(history)}) ==={Style.RESET_ALL}")
        for i, h in enumerate(reversed(history), 1):
            marker = "✓" if h.success else "✗"
            print(f"{i}. [{marker}] {h.shell_type.name}: {h.command[:60]}")
        print()
    
    def show_help(self):
        """Affiche aide."""
        help_text = f"""
{Fore.CYAN}=== COMMANDES DISPONIBLES ==={Style.RESET_ALL}

{Fore.GREEN}Exécution:{Style.RESET_ALL}
  bash <cmd>       Exécute sous Bash/Linux
  ps <cmd>         Exécute sous PowerShell
  docker <cmd>     Exécute dans container Docker
  py <code>        Exécute code Python sandbox
  git <cmd>        Commandes Git

{Fore.GREEN}Utilité:{Style.RESET_ALL}
  stats            Statistiques session
  history          Voir historique
  clear            Effacer écran
  help             Cette aide
  exit/quit        Quitter

{Fore.YELLOW}Exemples:{Style.RESET_ALL}
  bash ls -la
  docker echo hello
  py print(2+2)
  ps Get-Process
"""
        print(help_text)
    
    def clear_screen(self):
        """Efface écran."""
        os.system('cls' if platform.system() == 'Windows' else 'clear')
    
    def quit(self):
        """Quitte."""
        self.running = False
        print(f"\n{Fore.GREEN}👋 À bientôt, nexus!{Style.RESET_ALL}")
        self.terminal.cleanup()
    
    def cleanup(self):
        """Nettoyage."""
        self.terminal.cleanup()

