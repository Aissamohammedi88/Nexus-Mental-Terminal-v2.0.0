class SecurityValidator:
    """Validateur sécurité pour commandes."""
    
    def __init__(self, config: TerminalConfig):
        self.config = config
        self.blocked_patterns = [
            r"rm\s+-rf\s+/",
            r"mkfs\.+",
            r"dd\s+if=/dev/zero",
            r":\{\}\:\|\:\&\;\{\}\:",
            r"chmod\s+-R\s+777\s+/",
            r"passwd\s+root",
            r"sudo\s+su",
            r">/\dev/",
            r"echo\s+".* >/etc/",
            r"wget\s+http.*\|.*sh",
            r"curl\s+http.*\|.*bash"
        ]
    
    def validate(self, command: str, level: SecurityLevel) -> Tuple[bool, str]:
        """
        Valide une commande.
        Returns: (est_valide, message)
        """
        if level == SecurityLevel.PARANOID:
            return False, "Mode lecture seule uniquement"
        
        # Check blocked commands
        if command in self.config.BLOCKED_COMMANDS:
            return False, "Commande explicitement bloquée"
        
        # Check patterns
        for pattern in self.blocked_patterns:
            if re.search(pattern, command, re.IGNORECASE):
                return False, f"Pattern dangereux détecté: {pattern}"
        
        return True, "Commande autorisée"
    
    def sanitize_path(self, path: str, base_dir: Optional[str] = None) -> str:
        """Sécurise chemin."""
        if base_dir:
            base = Path(base_dir).resolve()
            target = Path(path).resolve()
            
            try:
                target.relative_to(base)
                return str(target)
            except ValueError:
                raise ValueError(f"Chemin hors base: {path}")
        return path

