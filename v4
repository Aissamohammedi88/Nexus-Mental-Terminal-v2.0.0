def main():
    """Point d'entrée principal."""
    parser = argparse.ArgumentParser(
        description="Nexus Intelligent Terminal v2.0",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Exemples:
  python terminal.py --interactive
  python terminal.py --test
  python terminal.py --config config.json
        """
    )
    
    parser.add_argument(
        '--interactive', '-i',
        action='store_true',
        help='Mode interactif'
    )
    
    parser.add_argument(
        '--test', '-t',
        action='store_true',
        help='Lancer tests'
    )
    
    parser.add_argument(
        '--config', '-c',
        type=str,
        help='Fichier configuration JSON'
    )
    
    parser.add_argument(
        '--quiet', '-q',
        action='store_true',
        help='Mode silencieux'
    )
    
    args = parser.parse_args()
    
    # Chargement config
    config = TerminalConfig()
    if args.config and os.path.exists(args.config):
        with open(args.config) as f:
            custom_config = json.load(f)
            for k, v in custom_config.items():
                if hasattr(config, k):
                    setattr(config, k, v)
    
    # Initialisation terminal
    terminal = HybridTerminal(config)
    
    if args.test:
        run_tests(terminal)
    elif args.interactive:
        InteractiveCLI(terminal).run()
    else:
        # Par défaut : démo
        run_demo(terminal)
    
    terminal.cleanup()

def run_tests(terminal: HybridTerminal):
    """Lance tests."""
    print(f"{Fore.CYAN}=== TESTS TERMINAL ==={Style.RESET_ALL}\n")
    
    tests = [
        ("bash ls -la", ShellType.BASH),
        ("bash pwd", ShellType.BASH),
        ("py print('Hello Nexus')", ShellType.PYTHON),
        ("echo test", ShellType.BASH),
    ]
    
    passed = 0
    failed = 0
    
    for cmd, shell in tests:
        result = terminal.execute(cmd, shell)
        status = "✓" if result.success else "✗"
        print(f"{status} {cmd}")
        if result.success:
            passed += 1
        else:
            failed += 1
            print(f"  Erreur: {result.stderr[:50]}")
    
    print(f"\n{passed}/{passed+failed} tests passés")

def run_demo(terminal: HybridTerminal):
    """Démo automatique."""
    print(f"{Fore.CYAN}=== DÉMO NEXUS TERMINAL ==={Style.RESET_ALL}\n")
    
    demos = [
        ("ls -la", ShellType.BASH, "Listing fichiers"),
        ("pwd", ShellType.BASH, "Répertoire actuel"),
        ("echo 'Hello from Nexus'", ShellType.BASH, "Message"),
        ("print('Python sandbox works!')", ShellType.PYTHON, "Python"),
    ]
    
    for cmd, shell, desc in demos:
        print(f"[{desc}]")
        result = terminal.execute(cmd, shell)
        print(f"  → {result.output_summary}")
        if result.stdout:
            print(f"  {result.stdout.strip()[:100]}")
        print()
    
    # Stats
    stats = terminal.get_session_stats()
    print(f"{Fore.CYAN}Session stats:{Style.RESET_ALL}")
    for k, v in stats.items():
        print(f"  {k}: {v}")

if __name__ == "__main__":
    main()
