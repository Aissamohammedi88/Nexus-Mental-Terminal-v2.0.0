def generate_jwt_secret(key_size: int = 32) -> str:
    """Génère secret JWT."""
    return secrets.token_hex(key_size)

def hash_command(cmd: str) -> str:
    """Hash commande pour audit."""
    return hashlib.sha256(cmd.encode()).hexdigest()[:16]

def create_timestamp_blockchain() -> str:
    """Crée timestamp blockchain simulé."""
    timestamp = datetime.now().isoformat()
    nonce = secrets.token_hex(8)
    data = f"{timestamp}:{nonce}"
    return hashlib.sha256(data.encode()).hexdigest()

