class BashTerminal(BaseTerminal):
    """Terminal Bash natif."""
    
    def execute(self, command: str, timeout: Optional[int] = None) -> CommandResult:
        """Exécute commande Bash."""
        timeout = timeout or self.config.DEFAULT_TIMEOUT
        result = CommandResult(command=command, shell_type=ShellType.BASH)
        
        # Validation sécurité
        is_valid, msg = self.security.validate(command, SecurityLevel.MEDIUM)
        if not is_valid:
            result.blocked = True
            result.stderr = f"Sécurité: {msg}"
            result.exit_code = 1
            self.logger.audit(f"BLOCAGE: {command}")
            return result
        
        start = time.time()
        self.logger.debug(f"[BASH] $ {command}")
        
        try:
            proc = subprocess.Popen(
                command,
                shell=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )
            result.pid = proc.pid
            
            try:
                stdout, stderr = proc.communicate(timeout=timeout)
                result.stdout = stdout[:self.config.MAX_OUTPUT_SIZE]
                result.stderr = stderr[:self.config.MAX_OUTPUT_SIZE]
                result.exit_code = proc.returncode
            except subprocess.TimeoutExpired:
                proc.kill()
                result.timeout = True
                result.stderr = f"Timeout après {timeout}s"
                result.exit_code = 124
        
        except Exception as e:
            result.stderr = f"Erreur Bash: {str(e)}"
            result.exit_code = 1
            self.logger.error(f"[BASH ERROR] {e}")
        
        result.duration_ms = (time.time() - start) * 1000
        self.logger.info(f"[BASH] {result.output_summary}")
        
        return result
    
    def get_capabilities(self) -> Dict[str, Any]:
        return {
            "shell": "bash",
            "platform": "linux/mac",
            "features": ["pipes", "redirection", "background", "jobs"]
        }

