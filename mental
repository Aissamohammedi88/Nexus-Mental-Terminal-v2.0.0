 if line.startswith("PY:"):code = line[3:].strip()
result = terminal.python(code)
else:
result = terminal.bash(line)

if result.stdout:
print(result.stdout, end="")
if result.stderr:
print(f"\033[91m{result.stderr}\033[0m", end="")

if result.exit_code != 0:
print(f"\033[90m[exit code: {result.exit_code}]\033[0m")

except KeyboardInterrupt:
