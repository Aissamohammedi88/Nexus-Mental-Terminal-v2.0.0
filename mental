# BRIDGE VERS LES API RÉELLES (Bash, PowerShell, Docker, SSH)
# ══════════════════════════════════════════════════════════════════════════════

class RealTerminalBridge:
"""
Pont vers les vrais terminaux (Bash, PowerShell, Docker, SSH).
À utiliser avec précaution — l'IA peut exécuter de vraies commandes.
"""

@staticmethod
def execute_bash_real(command: str, timeout: int = 30) -> CommandResult:
"""Exécute une vraie commande Bash sur le système Linux/Mac."""
start = time.time()
r = CommandResult(command=command)
try:
result = subprocess.run(
command, shell=True, capture_output=True, text=True, timeout=timeout
)
r.stdout = result.stdout
r.stderr = result.stderr
r.exit_code = result.returncode
except subprocess.TimeoutExpired:
r.stderr = f"Timeout après {timeout}s\n"
r.exit_code = 124
except Exception as e:
r.stderr = f"Erreur Bash : {e}\n"
r.exit_code = 1
r.duration_ms = (time.time() - start) * 1000
return r

@staticmethod
def execute_powershell_real(command: str, timeout: int = 30) -> CommandResult:
"""Exécute une vraie commande PowerShell (Windows)."""
start = time.time()
r = CommandResult(command=command)
try:
result = subprocess.run(
["powershell", "-Command", command],
capture_output=True, text=True, timeout=timeout
)
r.stdout = result.stdout
r.stderr = result.stderr
r.exit_code = result.returncode
except FileNotFoundError:
r.stderr = "PowerShell non trouvé sur ce système.\n"
r.exit_code = 127
except subprocess.TimeoutExpired:
r.stderr = f"Timeout après {timeout}s\n"
r.exit_code = 124
except Exception as e:
r.stderr = f"Erreur PowerShell : {e}\n"
r.exit_code = 1
r.duration_ms = (time.time() - start) * 1000
return r

@staticmethod
def execute_docker(command: str, container: str = "alpine", timeout: int = 30) -> CommandResult:
"""Exécute une commande dans un conteneur Docker isolé."""
start = time.time()
r = CommandResult(command=f"docker run --rm {container} {command}")
try:
result = subprocess.run(
["docker", "run", "--rm", container, "sh", "-c", command],
capture_output=True, text=True, timeout=timeout
)
r.stdout = result.stdout
r.stderr = result.stderr
r.exit_code = result.returncode
except FileNotFoundError:
r.stderr = "Docker non trouvé. Installe Docker.\n"
r.exit_code = 127
except subprocess.TimeoutExpired:
r.stderr = f"Timeout Docker après {timeout}s\n"
r.exit_code = 124
except Exception as e:
r.stderr = f"Erreur Docker : {e}\n"
r.exit_code = 1
r.duration_ms = (time.time() - start) * 1000
return r

@staticmethod
def execute_ssh(host: str, user: str, command: str, key_path: str = None) -> CommandResult:
"""Exécute une commande via SSH (nécessite paramiko)."""
start = time.time()
r = CommandResult(command=f"ssh {user}@{host} '{command}'")
try:
import paramiko
client = paramiko.SSHClient()
client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
client.connect(hostname=host, username=user, key_filename=key_path, timeout=10)
stdin, stdout, stderr = client.exec_command(command, timeout=30)
r.stdout = stdout.read().decode()
r.stderr = stderr.read().decode()
r.exit_code = stdout.channel.recv_exit_status()
client.close()
except ImportError:
r.stderr = "paramiko non installé. pip install paramiko\n"
r.exit_code = 127
except Exception as e:
r.stderr = f"Erreur SSH : {e}\n"
r.exit_code = 1
r.duration_ms = (time.time() - start) * 1000
return r


