class HybridTerminalTool(MentalTerminalTool):
"""
Version hybride : terminal mental par défaut + accès aux vrais terminaux.
"""

def __init__(self):
super().__init__()
self.bridge = RealTerminalBridge()

@staticmethod
def get_tool_schema() -> List[Dict[str, Any]]:
"""Ajoute les tools réels à la liste."""
base_schema = MentalTerminalTool.get_tool_schema()
real_schema = [
{
"type": "function",
"function": {
"name": "real_bash",
"description": "Exécute une VRAIE commande bash sur le système. ⚠️ ATTENTION : aucun sandbox.",
"parameters": {
"type": "object",
"properties": {
"command": {"type": "string"},
"timeout": {"type": "integer", "default": 30}
},
"required": ["command"]
}
}
},
{
"type": "function",
"function": {
"name": "real_powershell",
"description": "Exécute une VRAIE commande PowerShell (Windows).",
"parameters": {
"type": "object",
"properties": {
"command": {"type": "string"},
"timeout": {"type": "integer", "default": 30}
},
"required": ["command"]
}
}
},
{
"type": "function",
"function": {
"name": "docker_exec",
"description": "Exécute une commande dans un conteneur Docker isolé (sandbox réel).",
"parameters": {
"type": "object",
"properties": {
"command": {"type": "string"},
"container": {"type": "string", "default": "alpine"}
},
"required": ["command"]
}
}
},
{
"type": "function",
"function": {
"name": "ssh_exec",
"description": "Exécute une commande via SSH sur une machine distante.",
"parameters": {
"type": "object",
"properties": {
"host": {"type": "string"},
"user": {"type": "string"},
"command": {"type": "string"},
"key_path": {"type": "string"}
},
"required": ["host", "user", "command"]
}
}
},
]
return base_schema + real_schema

def execute_tool(self, name: str, args: Dict[str, Any]) -> Dict[str, Any]:
"""Exécute le bon terminal selon le tool demandé."""
if name == "real_bash":
result = self.bridge.execute_bash_real(args["command"], args.get("timeout", 30))
return result.to_dict()
elif name == "real_powershell":
result = self.bridge.execute_powershell_real(args["command"], args.get("timeout", 30))
return result.to_dict()
elif name == "docker_exec":
result = self.bridge.execute_docker(args["command"], args.get("container", "alpine"))
return result.to_dict()
elif name == "ssh_exec":
result = self.bridge.execute_ssh(
args["host"], args["user"], args["command"], args.get("key_path")
)
return result.to_dict()
else:
return super().execute_tool(name, args)


