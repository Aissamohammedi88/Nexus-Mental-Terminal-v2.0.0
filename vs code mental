# MOTEUR DE BUFFER (GESTION DES ONGLETS)
# ══════════════════════════════════════════════════════════════════════════════

class BufferManager:
"""Gestionnaire d'onglets d'édition"""

def __init__(self):
self.buffers: Dict[str, Buffer] = {}
self.active_buffer_id: Optional[str] = None

def open(self, path: str, content: str = "", language: str = "text") -> Buffer:
"""Ouvre un fichier dans un nouveau buffer"""
buf = Buffer(path=path, content=content, language=language)
self.buffers[buf.id] = buf
self.active_buffer_id = buf.id
return buf

def close(self, buffer_id: str) -> bool:
"""Ferme un buffer"""
if buffer_id in self.buffers:
del self.buffers[buffer_id]
if self.active_buffer_id == buffer_id:
self.active_buffer_id = next(iter(self.buffers), None)
return True
return False

def get_active(self) -> Optional[Buffer]:
"""Retourne le buffer actif"""
if self.active_buffer_id:
return self.buffers.get(self.active_buffer_id)
return None

def set_active(self, buffer_id: str) -> bool:
"""Change le buffer actif"""
if buffer_id in self.buffers:
self.active_buffer_id = buffer_id
return True
return False

def list_buffers(self) -> List[Dict]:
"""Liste tous les buffers ouverts"""
return [
{
"id": buf.id,
"path": buf.path,
"language": buf.language,
"modified": buf.is_modified,
"lines": buf.line_count,
"active": buf.id == self.active_buffer_id,
}
for buf in self.buffers.values()
]

def save(self, buffer_id: str) -> bool:
"""Marque un buffer comme sauvegardé"""
buf = self.buffers.get(buffer_id)
if buf:
buf.original_content = buf.content
buf.state = BufferState.SAVED
return True
return False

def save_all(self) -> int:
"""Sauvegarde tous les buffers"""
count = 0
for buf_id in self.buffers:
if self.save(buf_id):
count += 1
return count


