# MOTEUR DE RECHERCHE & REMPLACEMENT
# ══════════════════════════════════════════════════════════════════════════════

class SearchEngine:
"""Moteur de recherche et remplacement"""

@staticmethod
def search(content: str, query: str, regex: bool = False,
case_sensitive: bool = True) -> List[Dict]:
"""Recherche dans le contenu"""
results = []
lines = content.split("\n")

for i, line in enumerate(lines):
if regex:
flags = 0 if case_sensitive else re.IGNORECASE
try:
for match in re.finditer(query, line, flags):
results.append({
"line": i,
"col": match.start(),
"text": line,
"match": match.group(),
"length": match.end() - match.start(),
})
except re.error:
pass
else:
search_line = line if case_sensitive else line.lower()
search_query = query if case_sensitive else query.lower()
start = 0
while True:
pos = search_line.find(search_query, start)
if pos == -1:
break
results.append({
"line": i,
"col": pos,
"text": line,
"match": line[pos:pos + len(query)],
"length": len(query),
})
start = pos + 1

return results

@staticmethod
def replace(content: str, query: str, replacement: str,
regex: bool = False, case_sensitive: bool = True,
count: int = 0) -> Tuple[str, int]:
"""Remplace dans le contenu"""
if regex:
flags = 0 if case_sensitive else re.IGNORECASE
try:
if count > 0:
new_content = re.sub(query, replacement, content, count=count, flags=flags)
else:
new_content = re.sub(query, replacement, content, flags=flags)
num_replaced = len(re.findall(query, content, flags))
return new_content, num_replaced
except re.error:
return content, 0
else:
if case_sensitive:
num = content.count(query)
if count > 0:
num = min(num, count)
new_content = content.replace(query, replacement, count if count > 0 else -1)
return new_content, num
else:
pattern = re.compile(re.escape(query), re.IGNORECASE)
num = len(pattern.findall(content))
if count > 0:
num = min(num, count)
new_content = pattern.sub(replacement, content, count if count > 0 else 0)
return new_content, num


