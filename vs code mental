# MINI-GIT (VERSIONING EN MÉMOIRE)
# ══════════════════════════════════════════════════════════════════════════════

@dataclass
class Commit:
"""Un commit dans l'historique"""
id: str = field(default_factory=lambda: str(uuid.uuid4())[:8])
hash: str = ""
message: str = ""
content: str = ""
parent: Optional[str] = None
timestamp: float = field(default_factory=time.time)


class MiniGit:
"""Système de versioning en mémoire"""

def __init__(self):
self.commits: Dict[str, Commit] = {}
self.head: Optional[str] = None
self.branch: str = "main"

def commit(self, content: str, message: str = "Commit automatique") -> Commit:
"""Crée un commit"""
c = Commit(
hash=hashlib.sha256(content.encode()).hexdigest()[:12],
message=message,
content=content,
parent=self.head,
)
self.commits[c.id] = c
self.head = c.id
return c

def get_current(self) -> Optional[Commit]:
"""Retourne le commit HEAD"""
if self.head:
return self.commits.get(self.head)
return None

def get_history(self, limit: int = 20) -> List[Dict]:
"""Retourne l'historique des commits"""
history = []
current_id = self.head
while current_id and len(history) < limit:
commit = self.commits.get(current_id)
if not commit:
break
history.append({
"id": commit.id,
"hash": commit.hash,
"message": commit.message,
"timestamp": commit.timestamp,
})
current_id = commit.parent
return history

def diff(self, commit_id_1: str, commit_id_2: str) -> DiffResult:
"""Diff entre deux commits"""
c1 = self.commits.get(commit_id_1)
c2 = self.commits.get(commit_id_2)
if not c1 or not c2:
return DiffResult([], [], [])

lines1 = c1.content.split("\n")
lines2 = c2.content.split("\n")

differ = difflib.Differ()
diff = list(differ.compare(lines1, lines2))

added, removed, changed = [], [], []
for line in diff:
if line.startswith("+ "):
added.append(line[2:])
elif line.startswith("- "):
removed.append(line[2:])

return DiffResult(added, removed, changed)


