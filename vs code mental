class MentalEditor:
"""Éditeur de code complet pour IA"""

def __init__(self, vfs=None):
self.vfs = vfs
self.buffer_mgr = BufferManager()
self.ast_engine = ASTEngine()
self.search_engine = SearchEngine()
self.git = MiniGit()
self.opened_at = time.time()
self.commands_history = []

# ─── Gestion des fichiers ───
def open_file(self, path: str, language: str = "auto") -> Optional[Buffer]:
"""Ouvre un fichier depuis le VFS ou crée un nouveau"""
content = ""
if self.vfs and self.vfs.exists(path):
raw = self.vfs.read_file(path)
if raw:
content = raw.decode("utf-8", errors="replace")

if language == "auto":
ext = path.rsplit(".", 1)[-1].lower() if "." in path else ""
lang_map = {
"py": "python", "js": "javascript", "ts": "typescript",
"html": "html", "css": "css", "json": "json",
"md": "markdown", "txt": "text", "sh": "bash",
"rs": "rust", "go": "go", "java": "java", "c": "c",
"cpp": "cpp", "php": "php", "rb": "ruby", "sql": "sql",
}
language = lang_map.get(ext, "text")

buf = self.buffer_mgr.open(path, content, language)
self.git.commit(content, f"Ouverture de {path}")
return buf

def save_file(self, buffer_id: str = None) -> bool:
"""Sauvegarde un buffer dans le VFS"""
if buffer_id is None:
buf = self.buffer_mgr.get_active()
else:
buf = self.buffer_mgr.buffers.get(buffer_id)

if not buf:
return False

if self.vfs:
self.vfs.write_file(buf.path, buf.content.encode("utf-8"))

self.buffer_mgr.save(buf.id)
self.git.commit(buf.content, f"Sauvegarde de {buf.path}")
return True

# ─── Édition ───
def write(self, text: str) -> bool:
"""Écrit du texte dans le buffer actif"""
buf = self.buffer_mgr.get_active()
if not buf:
return False
buf.content += text
buf.state = BufferState.MODIFIED
return True

def replace_all(self, old: str, new: str) -> int:
"""Remplace tout dans le buffer actif"""
buf = self.buffer_mgr.get_active()
if not buf:
return 0
new_content, count = self.search_engine.replace(buf.content, old, new)
buf.content = new_content
buf.state = BufferState.MODIFIED
return count

def replace_regex(self, pattern: str, replacement: str) -> int:
"""Remplacement avec regex"""
buf = self.buffer_mgr.get_active()
if not buf:
return 0
new_content, count = self.search_engine.replace(
buf.content, pattern, replacement, regex=True
)
buf.content = new_content
buf.state = BufferState.MODIFIED
return count

def search(self, query: str, regex: bool = False) -> List[Dict]:
"""Cherche dans le buffer actif"""
buf = self.buffer_mgr.get_active()
if not buf:
return []
return self.search_engine.search(buf.content, query, regex)

def goto_line(self, line: int) -> bool:
"""Va à une ligne spécifique"""
buf = self.buffer_mgr.get_active()
if not buf:
return False
if 0 <= line < buf.line_count:
buf.cursor_line = line
return True
return False

def insert_at(self, line: int, col: int, text: str) -> bool:
"""Insère du texte à une position précise"""
buf = self.buffer_mgr.get_active()
if not buf:
return False
return buf.insert_text(line, col, text)

def delete_line(self, line: int) -> bool:
"""Supprime une ligne"""
buf = self.buffer_mgr.get_active()
if not buf:
return False
return buf.delete_line(line)

# ─── Analyse ───
def analyze(self) -> Optional[ASTAnalysis]:
"""Analyse le buffer actif"""
buf = self.buffer_mgr.get_active()
if not buf or buf.language != "python":
return None
return self.ast_engine.analyze(buf.content)

def get_functions(self) -> List[Dict]:
"""Retourne les fonctions du buffer actif"""
buf = self.buffer_mgr.get_active()
if not buf:
return []
return self.ast_engine.extract_functions(buf.content)

def get_classes(self) -> List[Dict]:
"""Retourne les classes du buffer actif"""
buf = self.buffer_mgr.get_active()
if not buf:
return []
return self.ast_engine.extract_classes(buf.content)

# ─── Git ───
def git_commit(self, message: str = "Commit") -> Optional[Commit]:
"""Crée un commit"""
buf = self.buffer_mgr.get_active()
if not buf:
return None
return self.git.commit(buf.content, message)

def git_history(self, limit: int = 10) -> List[Dict]:
"""Historique des commits"""
return self.git.get_history(limit)

def git_diff(self, commit1: str, commit2: str) -> DiffResult:
"""Diff entre deux commits"""
return self.git.diff(commit1, commit2)

# ─── Informations ───
def info(self) -> Dict:
"""Informations sur l'éditeur"""
buf = self.buffer_mgr.get_active()
return {
"uptime": round(time.time() - self.opened_at, 1),
"buffers_count": len(self.buffer_mgr.buffers),
"active_buffer": {
"id": buf.id if buf else None,
"path": buf.path if buf else None,
"language": buf.language if buf else None,
"lines": buf.line_count if buf else 0,
"modified": buf.is_modified if buf else False,
} if buf else None,
"git_commits": len(self.git.commits),
"git_head": self.git.head,
}


