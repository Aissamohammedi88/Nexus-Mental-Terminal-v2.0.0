class BufferState(Enum):
UNMODIFIED = "unmodified"
MODIFIED = "modified"
SAVED = "saved"

@dataclass
class Buffer:
"""Un onglet d'édition"""
id: str = field(default_factory=lambda: str(uuid.uuid4())[:8])
path: str = ""
content: str = ""
state: BufferState = BufferState.UNMODIFIED
cursor_line: int = 0
cursor_col: int = 0
language: str = "text"
original_content: str = ""

def __post_init__(self):
if not self.original_content:
self.original_content = self.content

@property
def is_modified(self) -> bool:
return self.content != self.original_content

@property
def line_count(self) -> int:
return len(self.content.split("\n"))

def get_lines(self) -> List[str]:
return self.content.split("\n")

def get_line(self, line_num: int) -> str:
lines = self.get_lines()
if 0 <= line_num < len(lines):
return lines[line_num]
return ""

def set_line(self, line_num: int, text: str) -> bool:
lines = self.get_lines()
if 0 <= line_num < len(lines):
lines[line_num] = text
self.content = "\n".join(lines)
self.state = BufferState.MODIFIED
return True
return False

def insert_text(self, line: int, col: int, text: str) -> bool:
lines = self.get_lines()
if not (0 <= line < len(lines)):
return False
lines[line] = lines[line][:col] + text + lines[line][col:]
self.content = "\n".join(lines)
self.state = BufferState.MODIFIED
return True

def delete_line(self, line_num: int) -> bool:
lines = self.get_lines()
if 0 <= line_num < len(lines):
del lines[line_num]
self.content = "\n".join(lines)
self.state = BufferState.MODIFIED
return True
return False

def get_hash(self) -> str:
return hashlib.sha256(self.content.encode()).hexdigest()[:12]


@dataclass
class DiffResult:
"""Résultat d'un diff"""
added: List[str]
removed: List[str]
changed: List[Tuple[str, str]]

def to_dict(self):
return {
"added": len(self.added),
"removed": len(self.removed),
"changed": len(self.changed),
"added_lines": self.added,
"removed_lines": self.removed,
}


@dataclass
class ASTAnalysis:
"""Résultat d'une analyse AST"""
valid: bool
functions: List[str]
classes: List[str]
imports: List[str]
variables: List[str]
errors: List[str]
warnings: List[str]

def to_dict(self):
return {
"valid": self.valid,
"functions": self.functions,
"classes": self.classes,
"imports": self.imports,
"variables": self.variables,
"errors": self.errors,
"warnings": self.warnings,
}


