"name": "editor_commit",
"description": "Crée un commit git.",
"parameters": {
"type": "object",
"properties": {"message": {"type": "string"}},
"required": ["message"]
}
}
},
]

def execute_tool(self, name: str, args: Dict) -> Dict:
if name == "editor_open":
buf = self.editor.open_file(args["path"], args.get("language", "auto"))
return {"success": buf is not None, "buffer_id": buf.id if buf else None}

elif name == "editor_save":
return {"success": self.editor.save_file()}

elif name == "editor_write":
return {"success": self.editor.write(args["text"])}

elif name == "editor_replace":
count = self.editor.replace_all(args["old"], args["new"])
return {"success": count > 0, "replacements": count}

elif name == "editor_analyze":
result = self.editor.analyze()
return result.to_dict() if result else {"error": "Buffer non-Python"}

elif name == "editor_commit":
commit = self.editor.git_commit(args["message"])
return {"success": commit is not None, "commit_id": commit.id if commit else None}

return {"error": f"Tool inconnu: {name}"}


