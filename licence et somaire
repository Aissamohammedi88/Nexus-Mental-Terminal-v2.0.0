#!/usr/bin/env python3
"""
jwt_generator.py - Générateur de tokens JWT pour tester l'API Nexus
"""

import jwt
import datetime
import secrets
import json
from cryptography.hazmat.primitives import serialization, hashes
from cryptography.hazmat.primitives.asymmetric import rsa, padding
from cryptography.hazmat.backends import default_backend

class JWTGenerator:
    def __init__(self, secret_key=None):
        self.secret_key = secret_key or secrets.token_hex(32)
        self.algorithm = "HS256"
        
    def generate_token(self, user_id, username="nexus_admin", 
                      permissions=None, expiration_minutes=60):
        """Génère un token JWT valide"""
        
        now = datetime.datetime.utcnow()
        
        payload = {
            "user_id": user_id,
            "username": username,
            "iat": now,
            "exp": now + datetime.timedelta(minutes=expiration_minutes),
            "iss": "Nexus Terminal Gateway v4.0",
            "aud": "nexus-api",
            "permissions": permissions or ["execute", "read", "audit"],
            "token_type": "bearer",
            "license_id": "NSL-2026-AISSA-9070-SOUVERAIN"
        }
        
        token = jwt.encode(payload, self.secret_key, algorithm=self.algorithm)
        return {
            "token": token,
            "payload": payload,
            "secret_key": self.secret_key,
            "algorithm": self.algorithm,
            "expires_in_seconds": expiration_minutes * 60
        }
    
    def generate_rsa_keys(self):
        """Génère paire RSA pour JWT RS256"""
        private_key = rsa.generate_private_key(
            public_exponent=65537,
            key_size=4096,
            backend=default_backend()
        )
        
        public_key = private_key.public_key()
        
        # Serialisation PEM
        private_pem = private_key.private_bytes(
            encoding=serialization.Encoding.PEM,
            format=serialization.PrivateFormat.PKCS8,
            encryption_algorithm=serialization.NoEncryption()
        )
        
        public_pem = public_key.public_bytes(
            encoding=serialization.Encoding.PEM,
            format=serialization.PublicFormat.SubjectPublicKeyInfo
        )
        
        return {
            "private_key": private_pem.decode(),
            "public_key": public_pem.decode()
        }
    
    def test_jwt_with_api(self, api_url, bearer_token):
        """Test le token contre l'API Nexus"""
        import requests
        
        headers = {
            "Authorization": f"Bearer {bearer_token}",
            "Content-Type": "application/json"
        }
        
        test_payload = {"command": "whoami"}
        
        response = requests.post(
            f"{api_url}/api/v1/execute",
            headers=headers,
            json=test_payload,
            timeout=10
        )
        
        return {
            "status_code": response.status_code,
            "response": response.json(),
            "headers": dict(response.headers)
        }

def generate_test_tokens():
    """Génère plusieurs tokens de test"""
    generator = JWTGenerator()
    
    tokens = []
    
    # Token Admin complet
    tokens.append(generator.generate_token(
        user_id="admin-001",
