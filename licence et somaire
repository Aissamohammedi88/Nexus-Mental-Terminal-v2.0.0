#!/usr/bin/env python3
"""
royalty_calculator.py - Calculateurs automatiques des royalties dues
"""

import json
import datetime
from typing import Dict, List
from dataclasses import dataclass, asdict

@dataclass
class RevenueReport:
    period_start: str
    period_end: str
    company_name: str
    total_revenue: float
    nexus_attributed_revenue: float
    currency: str = "EUR"
    
    def calculate_royalty(self, rate: float = 0.06) -> Dict:
        """Calcule les royalties dues"""
        royalty_amount = self.nexus_attributed_revenue * rate
        
        return {
            "company": self.company_name,
            "period": f"{self.period_start} to {self.period_end}",
            "total_revenue": self.total_revenue,
            "nexus_attributed": self.nexus_attributed_revenue,
            "royalty_rate": f"{rate*100}%",
            "amount_due": royalty_amount,
            "currency": self.currency,
            "due_date": self.period_end[:4] + "-" + self.period_end[5:7] + "-10",
            "calculation_date": datetime.datetime.now().isoformat()
        }

class RoyaltyCalculator:
    def __init__(self, rate=0.06):
        self.rate = rate
        self.payments = []
    
    def process_report(self, report_file: str):
        """Traite un rapport JSON"""
        with open(report_file) as f:
            report = json.load(f)
        
        calculation = RevenueReport(
            period_start=report["period_start"],
            period_end=report["period_end"],
            company_name=report["company"],
            total_revenue=report["total_revenue"],
            nexus_attributed_revenue=report.get("nexus_attributed_revenue", report["total_revenue"])
        ).calculate_royalty(self.rate)
        
        self.payments.append(calculation)
        return calculation
    
