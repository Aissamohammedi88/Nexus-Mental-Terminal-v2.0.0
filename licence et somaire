#!/usr/bin/env python3
"""
blockchain_timestamp.py - Script automatique de preuve d'antériorité
Utilise OpenTimestamps (gratuit) + Bitcoin blockchain pour preuve indélébile
"""

import hashlib
import subprocess
import json
import datetime
import os
from pathlib import Path

class BlockchainTimestamp:
    def __init__(self):
        self.ots_client = "ots"  # OpenTimestamps CLI
        self.calendar_url = "http://calendar.opentimestamps.org"
        
    def calculate_sha256(self, filepath):
        """Calcule le hash SHA-256 d'un fichier"""
        sha256_hash = hashlib.sha256()
        with open(filepath, "rb") as f:
            for byte_block in iter(lambda: f.read(4096), b""):
                sha256_hash.update(byte_block)
        return sha256_hash.hexdigest()
    
    def timestamp_file(self, filepath):
        """Applique timestamp blockchain à un fichier"""
        try:
            # 1. Vérifier installation ots
            result = subprocess.run([self.ots_client, "--version"], 
                                  capture_output=True, text=True)
            if result.returncode != 0:
                print("❌ OpenTimestamps CLI non installé")
                print("Installation : brew install opentimestamps (macOS)")
                print("Ou : apt install opentimestamps (Linux)")
                return None
            
            # 2. Timestamp le fichier
            print(f"⏳ Timestamping: {filepath}")
            result = subprocess.run([self.ots_client, "stamp", filepath],
                                  capture_output=True, text=True)
            
            if result.returncode != 0:
                print(f"❌ Erreur timestamp: {result.stderr}")
                return None
                
            ots_file = f"{filepath}.ots"
            print(f"✅ Fichier .ots créé: {ots_file}")
            
            # 3. Uploader vers calendar
            print("⏫ Soumission au calendar Bitcoin...")
            result = subprocess.run([self.ots_client, "submit", ots_file],
                                  capture_output=True, text=True)
            
            # 4. Vérifier inclusion blockchain
            print("🔍 Vérification blockchain...")
            result = subprocess.run([self.ots_client, "verify", ots_file],
                                  capture_output=True, text=True)
            
            if result.returncode == 0:
                print("✅ Pruve confirmée sur blockchain Bitcoin!")
                return self.generate_proof_document(filepath, ots_file)
            else:
                print(f"⚠️ Vérification échouée: {result.stderr}")
                return None
                
        except FileNotFoundError:
            print("❌ Commande 'ots' introuvable")
            return None
        except Exception as e:
            print(f"❌ Erreur: {e}")
            return None
    
    def timestamp_directory(self, dirpath):
        """Timestamp tous les fichiers importants d'un dossier"""
        important_files = ["LICENSE", "README.md", "src/core/terminal.py"]
        results = []
        
        for filename in important_files:
            filepath = os.path.join(dirpath, filename)
            if os.path.exists(filepath):
                result = self.timestamp_file(filepath)
                if result:
                    results.append(result)
        
        # Créer archive complète
        archive_name = f"nexus-{datetime.datetime.now().strftime('%Y%m%d')}.tar.gz"
        subprocess.run(["tar", "-czf", archive_name, "-C", dirpath, 
                       "LICENSE", "README.md", "src"])
        
        self.timestamp_file(archive_name)
        
        return results
    
    def generate_proof_document(self, filepath, ots_file):
        """Génère document de preuve JSON"""
        proof = {
            "file": str(filepath),
            "sha256": self.calculate_sha256(filepath),
            "ots_file": str(ots_file),
            "timestamp_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "blockchain": "Bitcoin",
            "verification_url": f"https://opentimestamps.org/verify/{ots_file}",
            "project": "Nexus Terminal Gateway v4.0",
            "author": "Aissa Mohammedi",
            "license_id": "NSL-2026-AISSA-9070-SOUVERAIN"
        }
        
        # Sauvegarder preuve
        proof_file = f"{filepath}.proof.json"
        with open(proof_file, "w") as f:
            json.dump(proof, f, indent=2)
        
        print(f"💾 Preuve sauvegardée: {proof_file}")
        return proof

def main():
    print("=" * 60)
    print("NEXUS BLOCKCHAIN TIMESTAMP v4.0")
    print("=" * 60)
    
    ts = BlockchainTimestamp()
    
    # Option 1: Timestamp fichier unique
    if len(sys.argv) > 1:
        filepath = sys.argv[1]
        ts.timestamp_file(filepath)
    
    # Option 2: Timestamp répertoire complet
    else:
        cwd = os.getcwd()
        print(f"📁 Répertoire courant: {cwd}")
        ts.timestamp_directory(cwd)
    
    print("\n" + "=" * 60)
    print("✅ TIMESTAMP COMPLET!")
    print("=" * 60)
    print("\nPreuves disponibles:")
    print("- Vérification : https://opentimestamps.org/")
    print("- Block explorer : https://blockchain.info/")
    print("- Documentation : https://opentimestamps.org/docs")

if __name__ == "__main__":
    import sys
    main()


