#!/usr/bin/env python3
"""
Client SSH pour connexions réelles aux serveurs Linux
"""

import asyncio
import paramiko
from typing import Optional, AsyncGenerator, Tuple
from dataclasses import dataclass
from pathlib import Path
import logging

logger = logging.getLogger("nexus.gateway.ssh")

@dataclass
class SSHConfig:
    host: str
    port: int = 22
    username: str
    password: Optional[str] = None
    private_key: Optional[Path] = None
    timeout: int = 30

class SSHClient:
    """Client SSH sécurisé pour exécution de commandes"""
    
    def __init__(self, config: SSHConfig):
        self.config = config
        self.client: Optional[paramiko.SSHClient] = None
        self.channel: Optional[paramiko.Channel] = None
    
    async def connect(self) -> bool:
        """Établir connexion SSH"""
        try:
            self.client = paramiko.SSHClient()
            self.client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
            
            connect_kwargs = {
                'hostname': self.config.host,
                'port': self.config.port,
                'username': self.config.username,
                'timeout': self.config.timeout,
            }
            
            if self.config.private_key:
                connect_kwargs['pkey'] = paramiko.RSAKey.from_private_key_file(str(self.config.private_key))
            elif self.config.password:
                connect_kwargs['password'] = self.config.password
            
            self.client.connect(**connect_kwargs)
            logger.info(f"SSH connecté à {self.config.host}")
            return True
        except Exception as e:
            logger.error(f"Erreur SSH: {e}")
            return False
    
    async def execute(self, command: str, timeout: int = 30) -> Tuple[int, str, str]:
        """
        Exécuter commande à distance.
        Retourne (exit_code, stdout, stderr)
        """
        if not self.client:
            await self.connect()
        
        try:
            stdin, stdout, stderr = self.client.exec_command(command, timeout=timeout)
            
            exit_status = stdout.channel.recv_exit_status()
            stdout_text = stdout.read().decode('utf-8', errors='replace')
            stderr_text = stderr.read().decode('utf-8', errors='replace')
            
            return (exit_status, stdout_text, stderr_text)
        except Exception as e:
            logger.error(f"Erreur exécution SSH: {e}")
            return (-1, "", str(e))
    
    async def execute_streaming(self, command: str) -> AsyncGenerator[str, None]:
        """Exécution avec streaming en temps réel"""
        if not self.client:
            await self.connect()
        
        channel = self.client.invoke_shell()
        channel.send(command + '\n')
        
        while True:
            if channel.recv_ready():
                data = channel.recv(4096).decode('utf-8', errors='replace')
                yield data
            if channel.closed:
                break
            await asyncio.sleep(0.1)
    
    async def disconnect(self):
        """Fermer connexion proprement"""
        if self.channel:
            self.channel.close()
        if self.client:
            self.client.close()
        logger.info("SSH déconnecté")
